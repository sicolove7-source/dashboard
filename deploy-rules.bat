@echo off
@chcp 65001 >nul
title ⚡ نشر قواعد الأمان فقط (Firestore Rules) - تشطيب برو
cd /d "%~dp0"

echo ================================================================
echo   🚀 نشر قواعد أمان فايربيس (Firestore Security Rules)
echo ================================================================
echo.
echo   [1/2] التحقق من تسجيل الدخول إلى Firebase...
echo.
call npx -y firebase-tools login
echo.
echo ================================================================
echo   [2/2] جاري نشر القواعد السحابية وتفعيل بوابات العملاء...
echo ================================================================
call npx -y firebase-tools deploy --only firestore:rules --project tashteeb-67d13
echo.
if %errorlevel% equ 0 (
    echo ================================================================
    echo   ✅ تم نشر القواعد السحابية بنجاح تام!
    echo   الآن أصبحت بوابات العملاء ومجموعات المشاريع مفعّلة سحابياً.
    echo ================================================================
) else (
    echo ================================================================
    echo   ⚠️ حدث خطأ أثناء النشر، يرجى مراجعة الرسالة أعلاه.
    echo ================================================================
)
echo.
pause

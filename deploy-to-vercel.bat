@echo off
chcp 65001 >nul
title رفع لوحة التحكم سحابياً على Vercel
cd /d "%~dp0"

echo ===================================================
echo     🚀 جاري تجهيز ورفع لوحة التحكم سحابياً...
echo ===================================================
echo.

echo [1/2] التحقق من بناء المشروع للتأكد من خلوه من الأخطاء...
call npm run build
if %errorlevel% neq 0 (
    echo [خطأ] فشل بناء المشروع! يرجى مراجعة الأخطاء أولاً.
    pause
    exit /b
)

echo.
echo [2/2] بدء الرفع على Vercel السحابي المجاني...
echo سيُطلب منك تسجيل الدخول لأول مرة فقط، وافق على الإعدادات الافتراضية بالضغط على Enter.
echo.
npx vercel --prod

echo.
echo ===================================================
echo   ✅ تم رفع لوحة التحكم بنجاح وأصبحت متاحة أونلاين!
echo ===================================================
pause

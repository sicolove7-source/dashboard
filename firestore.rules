rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.email == 'sicolove7@gmail.com' ||
        request.auth.token.email == 'admin@platform.com' ||
        request.auth.token.email == 'admin@tashteebpro.com'
      );
    }

    function companyBelongsToUser(companyId) {
      let tokenCompId = request.auth.token.companyId;
      let userEmail = request.auth.token.email;
      return isSuperAdmin() || (
        tokenCompId != null &&
        (
          tokenCompId == companyId ||
          ('comp_' + companyId) == tokenCompId ||
          companyId == ('comp_' + tokenCompId)
        )
      ) || (
        resource != null && (
          resource.data.adminEmail == userEmail ||
          resource.data.adminUid == request.auth.uid ||
          ('authorizedEmails' in resource.data && resource.data.authorizedEmails.hasAny([userEmail]))
        )
      ) || (
        request.resource != null && (
          request.resource.data.adminEmail == userEmail ||
          request.resource.data.adminUid == request.auth.uid ||
          ('authorizedEmails' in request.resource.data && request.resource.data.authorizedEmails.hasAny([userEmail]))
        )
      );
    }

    function companySubcollectionBelongsToUser(companyId) {
      let tokenCompId = request.auth.token.companyId;
      let userEmail = request.auth.token.email;
      return isSuperAdmin() || (
        tokenCompId != null &&
        (
          tokenCompId == companyId ||
          ('comp_' + companyId) == tokenCompId ||
          companyId == ('comp_' + tokenCompId)
        )
      ) || (
        exists(/databases/$(database)/documents/companies/$(companyId)) && (
          get(/databases/$(database)/documents/companies/$(companyId)).data.adminEmail == userEmail ||
          get(/databases/$(database)/documents/companies/$(companyId)).data.adminUid == request.auth.uid ||
          ('authorizedEmails' in get(/databases/$(database)/documents/companies/$(companyId)).data &&
           get(/databases/$(database)/documents/companies/$(companyId)).data.authorizedEmails.hasAny([userEmail]))
        )
      );
    }

    match /companies/{companyId} {
      allow read, write: if isAuthenticated() &&
                            companyId != '' &&
                            companyId != 'undefined' &&
                            companyId != 'null' &&
                            companyBelongsToUser(companyId);

      match /media/{mediaId} {
        allow read: if true;
        allow write: if companyBelongsToUser(companyId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated() &&
                              companyId != '' &&
                              companyId != 'undefined' &&
                              companySubcollectionBelongsToUser(companyId);
      }
    }

    match /portal_shares/{token} {
      allow read: if true;
      allow create: if companyBelongsToUser(request.resource.data.companyId);
      allow delete: if companyBelongsToUser(resource.data.companyId);
      allow update: if companyBelongsToUser(resource.data.companyId) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clientSignature', 'clientApprovalDate', 'clientApprovalNotes', 'updatedAt']);
    }

    match /portal_shares_media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /platform_metadata/superadmin {
      allow read, write: if false;
    }

    match /platform_metadata/platform_settings {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /platform_metadata/tenants {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /tenant_directory/{subdomain} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isAuthenticated() && resource == null);
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.adminEmail == request.auth.token.email ||
          resource.data.adminUid == request.auth.uid ||
          resource.data.companyId == request.auth.token.companyId ||
          ('comp_' + resource.data.companyId) == request.auth.token.companyId
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /platform_metadata/users_directory {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /platform_metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true
      );
    }

    function isCompanyMemberOrAdmin(companyId) {
      let tokenCompId = request.auth.token.companyId;
      let userEmail = request.auth.token.email;
      let userId = request.auth.uid;

      return isSuperAdmin() || (
        tokenCompId != null && tokenCompId == companyId
      ) || (
        resource != null && (
          resource.data.adminEmail == userEmail ||
          resource.data.adminUid == userId ||
          ('authorizedEmails' in resource.data && resource.data.authorizedEmails.hasAny([userEmail])) ||
          ('authorizedUids' in resource.data && resource.data.authorizedUids.hasAny([userId]))
        )
      );
    }

    function companySubcollectionBelongsToUser(companyId) {
      let tokenCompId = request.auth.token.companyId;
      let userEmail = request.auth.token.email;
      let userId = request.auth.uid;
      let compPath = /databases/$(database)/documents/companies/$(companyId);

      return isSuperAdmin() || (
        tokenCompId != null && tokenCompId == companyId
      ) || (
        exists(compPath) && (
          get(compPath).data.adminEmail == userEmail ||
          get(compPath).data.adminUid == userId ||
          ('authorizedEmails' in get(compPath).data && get(compPath).data.authorizedEmails.hasAny([userEmail])) ||
          ('authorizedUids' in get(compPath).data && get(compPath).data.authorizedUids.hasAny([userId]))
        )
      );
    }

    match /companies/{companyId} {
      function isCompanyAdminDirect() {
        let compPath = /databases/$(database)/documents/companies/$(companyId);
        return exists(compPath) && (
          get(compPath).data.adminEmail == request.auth.token.email ||
          get(compPath).data.adminUid == request.auth.uid
        );
      }

      function hasAnyRole(roles) {
        return isSuperAdmin() ||
               isCompanyAdminDirect() ||
               (request.auth.token.role == null) ||
               (request.auth.token.role in roles);
      }

      function isCompanyManagerOrAdmin() {
        return isSuperAdmin() ||
               isCompanyAdminDirect() ||
               (request.auth.token.role == null) ||
               (request.auth.token.role != null && request.auth.token.role in ['owner', 'admin']);
      }

      // 1. القراءة: لأعضاء الشركة فقط أو السوبر أدمن
      allow read: if isAuthenticated() && isCompanyMemberOrAdmin(companyId);

      // 2. الإنشاء الأولي للشركة: للمستخدم المسجل لشركته الخاصة فقط (أو السوبر أدمن)
      allow create: if isAuthenticated() && resource == null && (
        isSuperAdmin() ||
        request.resource.data.adminUid == request.auth.uid ||
        request.resource.data.adminEmail == request.auth.token.email
      );

      // 3. التعديل: للمالك أو السوبر أدمن، مع منع سرقة الحساب بتغيير adminUid أو adminEmail
      allow update: if isAuthenticated() && resource != null && isCompanyMemberOrAdmin(companyId) && (
        isSuperAdmin() ||
        (
          (!('adminUid' in request.resource.data) || request.resource.data.adminUid == resource.data.adminUid) &&
          (!('adminEmail' in request.resource.data) || request.resource.data.adminEmail == resource.data.adminEmail)
        )
      );

      // 4. الحذف: للسوبر أدمن أو المالك الرئيسي الأصلي فقط
      allow delete: if isAuthenticated() && resource != null && (
        isSuperAdmin() || resource.data.adminUid == request.auth.uid
      );

      // ── المجموعات الفرعية المحددة بحسب الصلاحيات والأدوار ──
      match /projects/{projectId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'tech_office']));
      }

      match /finance/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'accountant', 'manager']));
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'accountant']));
      }

      match /crm/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'tech_office', 'customer_service']));
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager']));
      }

      match /subcontractors/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'tech_office', 'procurement']));
      }

      match /workOrders/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'procurement']));
      }

      match /extracts/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'accountant']));
      }

      match /suppliers/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'accountant', 'procurement']));
      }

      match /quotations/{docId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'accountant', 'tech_office']));
      }

      match /users/{userId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) && isCompanyManagerOrAdmin();
      }

      match /team/{memberId} {
        allow read: if isAuthenticated() && companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() && companySubcollectionBelongsToUser(companyId) && isCompanyManagerOrAdmin();
      }

      match /media/{mediaId} {
        allow read: if isAuthenticated() && isCompanyMemberOrAdmin(companyId);
        allow write: if isAuthenticated() && isCompanyMemberOrAdmin(companyId) &&
          (isSuperAdmin() || hasAnyRole(['owner', 'admin', 'manager', 'engineer', 'tech_office', 'procurement']));
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() &&
                       companyId != '' &&
                       companyId != 'undefined' &&
                       companySubcollectionBelongsToUser(companyId);
        allow write: if isAuthenticated() &&
                        companyId != '' &&
                        companyId != 'undefined' &&
                        companySubcollectionBelongsToUser(companyId) &&
                        isCompanyManagerOrAdmin();
      }
    }

    function companyDocBelongsToUser(companyId) {
      let tokenCompId = request.auth.token.companyId;
      let userEmail = request.auth.token.email;
      let compPath = /databases/$(database)/documents/companies/$(companyId);
      return isSuperAdmin() || (
        tokenCompId != null &&
        tokenCompId == companyId
      ) || (
        exists(compPath) && (
          get(compPath).data.adminEmail == userEmail ||
          get(compPath).data.adminUid == request.auth.uid ||
          ('authorizedEmails' in get(compPath).data && get(compPath).data.authorizedEmails.hasAny([userEmail]))
        )
      );
    }

    match /portal_shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() &&
                       'companyId' in request.resource.data &&
                       companyDocBelongsToUser(request.resource.data.companyId);
      allow delete: if isAuthenticated() && companyDocBelongsToUser(resource.data.companyId);
      allow update: if (
        isAuthenticated() &&
        companyDocBelongsToUser(resource.data.companyId) &&
        (!('companyId' in request.resource.data) || request.resource.data.companyId == resource.data.companyId)
      ) || (
        (!('companyId' in request.resource.data) || request.resource.data.companyId == resource.data.companyId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clientSignature', 'clientApprovalDate', 'clientApprovalNotes', 'updatedAt'])
      );
    }

    match /portal_shares_media/{mediaId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        ('companyId' in request.resource.data && companyDocBelongsToUser(request.resource.data.companyId))
      );
    }

    // ── وثائق platform_metadata الصريحة حصراً (تم حذف أي wildcard لمنع تداخل OR) ──
    match /platform_metadata/superadmin {
      allow read, write: if false;
    }

    match /platform_metadata/users_directory {
      allow read, write: if false;
    }

    match /platform_metadata/platform_settings {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /platform_metadata/deleted_tenants {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /platform_metadata/tenants {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── مسار tenants/{companyId}: القراءة عامة للبيانات الأساسية والكتابة للسوبر أدمن فقط لمنع تعديل الخطط والأدوار من العميل ──
    match /tenants/{companyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /tenant_directory/{subdomain} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        isAuthenticated() && resource == null &&
        !subdomain.matches('^(admin|api|portal|app|tashteeb|system|superadmin|root|null|undefined)$') &&
        'companyId' in request.resource.data &&
        companyDocBelongsToUser(request.resource.data.companyId)
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

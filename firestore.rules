rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.email == 'sicolove7@gmail.com' ||
        request.auth.token.email == 'admin@platform.com' ||
        request.auth.token.email == 'admin@tashteebpro.com'
      );
    }

    // 1. بيانات كل شركة ومشروعاتها وفريقها وعملائها (عزل تام لكل شركة)
    match /companies/{companyId} {
      allow read, write: if isAuthenticated() &&
                            companyId != null &&
                            companyId != '' &&
                            companyId != 'undefined' &&
                            companyId != 'null' &&
                            (request.auth.token.companyId == null || request.auth.token.companyId == companyId || isSuperAdmin());

      // وسائط الشركة (Cloud Media Vault): قراءة عامة للصور لظهورها في أي جهاز وبوابة العميل، وكتابة للمصرح لهم
      match /media/{mediaId} {
        allow read: if true;
        allow write: if isAuthenticated() || isSuperAdmin();
      }

      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated() &&
                              companyId != null &&
                              companyId != '' &&
                              companyId != 'undefined' &&
                              (request.auth.token.companyId == null || request.auth.token.companyId == companyId || isSuperAdmin());
      }
    }

    // 2. بوابة العميل بالتوكن السري فقط (قراءة عامة للعميل، ونشر وتوقيع آمن)
    match /portal_shares/{token} {
      // قراءة المشروع بالتوكن متاحة لأي زائر خارجي
      allow read: if true;
      // السماح بنشر وحذف البوابة للمستخدم الموثق (المقاول / المشرف)
      allow create, delete: if isAuthenticated();
      // السماح بالتحديث للمستخدم الموثق أو للعميل غير المسجل بتحديث التوقيع والاعتماد فقط
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clientSignature', 'clientApprovalDate', 'clientApprovalNotes', 'updatedAt'])
      );
    }

    // 2b. الخزينة السحابية العامة لوسائط المنصة وبوابات العملاء (Cloud Media Vault)
    match /portal_shares_media/{mediaId} {
      allow read, write: if true;
    }

    // 3. منصة الإدارة المركزية (platform_metadata)
    // منع الوصول لبيانات المشرف السري
    match /platform_metadata/superadmin {
      allow read, write: if false;
    }

    // إعدادات المنصة: قراءة للجميع، كتابة للمشرف العام
    match /platform_metadata/platform_settings {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // دليل الشركات المشتركة: متاح للقراءة لدعم النطاقات الفرعية (Subdomains) للزوار
    match /platform_metadata/tenants {
      allow read: if true;
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // دليل السابدومين العام المخصص لربط السابدومين بالشركة للزوار بدون تسجيل دخول
    match /tenant_directory/{subdomain} {
      allow read, write: if true;
    }

    // دليل المستخدمين المركزي: قراءة للجميع لدعم تسجيل دخول الموظفين بالهاتف، وكتابة للموثقين والسوبر أدمن
    match /platform_metadata/users_directory {
      allow read: if true;
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // أي وثائق إدارية أخرى في platform_metadata
    match /platform_metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 4. إغلاق أي مسار آخر غير معرف
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

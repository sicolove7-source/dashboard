rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // التعرف على السوبر أدمن عبر الـ Custom Claims أو الإيميل المباشر
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.email == 'admin@platform.com' ||
        request.auth.token.email == 'sicolove7@gmail.com'
      );
    }

    function isSubAccountsAllowed() {
      return !exists(/databases/$(database)/documents/platform_metadata/platform_settings) ||
             get(/databases/$(database)/documents/platform_metadata/platform_settings).data.subAccountsAllowed != false;
    }

    // عزل الشركات الصارم: السماح فقط إذا كان التوكن المشفر يحمل نفس معرف الشركة
    function isAuthorized(companyId) {
      return isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.token.companyId == companyId &&
          isSubAccountsAllowed()
        )
      );
    }

    function hasValidCompanyPayload(companyId) {
      return !('companyId' in request.resource.data) ||
             request.resource.data.companyId == companyId ||
             isSuperAdmin();
    }

    // 1. حماية بيانات الشركات
    match /companies/{companyId} {
      allow read: if isAuthorized(companyId);
      allow create: if isAuthorized(companyId) || (
        isAuthenticated() &&
        hasValidCompanyPayload(companyId) &&
        (
          request.resource.data.adminEmail == request.auth.token.email ||
          (request.resource.data.settings != null && request.resource.data.settings.adminEmail == request.auth.token.email)
        )
      );
      allow update: if isAuthorized(companyId) && hasValidCompanyPayload(companyId);
      allow delete: if isAuthorized(companyId);

      match /projects/{projectId} {
        allow read, write: if isAuthorized(companyId) && hasValidCompanyPayload(companyId);
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthorized(companyId);
        allow create, update, delete: if isAuthorized(companyId) && hasValidCompanyPayload(companyId);
      }
    }

    // 2. بوابة العميل بالتوكن السري فقط (قراءة)
    match /portal_shares/{token} {
      allow read: if true;
      allow write: if false;
    }

    // 3. إعدادات المنصة المركزية
    match /platform_metadata/{docId} {
      match /superadmin {
        allow read, write: if false;
      }
      match /platform_settings {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
      match /tenants {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin();
      }
      allow read, write: if isSuperAdmin();
    }

    // 4. إغلاق أي مسار آخر
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

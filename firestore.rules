rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.email == 'sicolove7@gmail.com' ||
        request.auth.token.email.matches('(?i)^sicolove7@gmail\\.com$')
      );
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.companyId != null && request.auth.token.companyId == companyId) ||
        (exists(/databases/$(database)/documents/companies/$(companyId)) && (
          (request.auth.token.email != null && (
            (get(/databases/$(database)/documents/companies/$(companyId)).data.authorizedEmails != null &&
             request.auth.token.email in get(/databases/$(database)/documents/companies/$(companyId)).data.authorizedEmails) ||
            get(/databases/$(database)/documents/companies/$(companyId)).data.adminEmail == request.auth.token.email ||
            (get(/databases/$(database)/documents/companies/$(companyId)).data.settings != null &&
             get(/databases/$(database)/documents/companies/$(companyId)).data.settings.adminEmail == request.auth.token.email)
          )) ||
          get(/databases/$(database)/documents/companies/$(companyId)).data.adminUid == request.auth.uid
        ))
      );
    }

    // 1. بيانات كل شركة ومشروعاتها وفريقها وعملائها (عزل تام لكل شركة)
    match /companies/{companyId} {
      // قراءة وثيقة الشركة الفردية: مسموح لأعضاء الشركة المعنية أو السوبر أدمن
      allow get: if isCompanyMember(companyId);

      // منع سحب قائمة كل الشركات لغير السوبر أدمن نهائياً لمنع استعراض شركات المنصة
      allow list: if isSuperAdmin();

      // كتابة وتعديل وثيقة الشركة: مسموح لأعضاء الشركة المعنية أو السوبر أدمن
      allow write: if isCompanyMember(companyId);

      // المجموعات الفرعية للشركة ومشاريعها بأي عمق (مشاريع، مقاولو باطن، مستخلصات، إلخ)
      match /{allSubcollections=**} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // 2. بوابة العميل بالتوكن السري: قراءة مستند واحد فقط بالتوكن (ممنوع الـ list لمنع سحب بوابات العملاء)
    match /portal_shares/{token} {
      // قراءة المشروع من رابط البوابة متاحة لأي شخص يملك التوكن
      allow get: if true;
      // منع استعراض كل الروابط لحماية خصوصية المشاريع
      allow list: if false;
      // السماح لأعضاء الشركة المالكة وللسوبر أدمن بنشر وتحديث وحذف بوابات المشاريع
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource != null && isCompanyMember(request.resource.data.companyId)) ||
        (resource != null && isCompanyMember(resource.data.companyId))
      );
    }

    // 3. منصة الإدارة المركزية (platform_metadata)
    // منع الوصول لبيانات المشرف السري
    match /platform_metadata/superadmin {
      allow read, write: if false;
    }

    // إعدادات المنصة: قراءة للجميع، كتابة للمشرف العام
    match /platform_metadata/platform_settings {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // دليل الشركات المشتركة: متاح للقراءة لدعم النطاقات الفرعية (Subdomains) للزوار، كتابة للمستخدمين الموثقين والمشرف العام
    match /platform_metadata/tenants {
      allow read: if true;
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // دليل السابدومين العام المخصص لربط السابدومين بالشركة للزوار بدون تسجيل دخول
    // يسمح بـ get فقط للزائر، ويمنع list لمنع حصر كل النطاقات
    match /tenant_directory/{subdomain} {
      allow get: if true;
      allow list: if false;
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // دليل المستخدمين المركزي: قراءة للجميع للبحث الفوري أثناء تسجيل الدخول، وكتابة للمستخدمين الموثقين والمشرف العام
    match /platform_metadata/users_directory {
      allow read: if true;
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // أي وثائق إدارية أخرى في platform_metadata
    match /platform_metadata/{docId} {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 4. إغلاق أي مسار آخر غير معرف
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

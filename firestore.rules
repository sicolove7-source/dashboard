rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.email == 'sicolove7@gmail.com' ||
        request.auth.token.email.matches('(?i)^sicolove7@gmail\\.com$')
      );
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        request.auth.token.companyId == companyId ||
        isSuperAdmin()
      );
    }

    // 1. بيانات كل شركة ومشروعاتها وفريقها وعملائها (عزل تام لكل شركة)
    match /companies/{companyId} {
      // قراءة وثيقة الشركة الفردية: مسموح فقط لأعضاء نفس الشركة أو المالك المسجل أو السوبر أدمن
      allow get: if isAuthenticated() && (
        request.auth.token.companyId == companyId ||
        (resource != null && (resource.data.adminUid == request.auth.uid || resource.data.adminEmail == request.auth.token.email)) ||
        isSuperAdmin()
      );

      // منع سحب قائمة كل الشركات لغير السوبر أدمن نهائياً لمنع استعراض شركات المنصة
      allow list: if isSuperAdmin();

      // كتابة وتعديل وثيقة الشركة: مسموح لأعضاء الشركة المعنية أو المالك أو السوبر أدمن
      allow write: if isAuthenticated() && (
        request.auth.token.companyId == companyId ||
        (resource != null && (resource.data.adminUid == request.auth.uid || resource.data.adminEmail == request.auth.token.email)) ||
        (request.resource != null && (request.resource.data.adminUid == request.auth.uid || request.resource.data.adminEmail == request.auth.token.email)) ||
        isSuperAdmin()
      );

      // المجموعات الفرعية للشركة ومشاريعها بأي عمق (مشاريع، مقاولو باطن، مستخلصات، إلخ)
      match /{allSubcollections=**} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // 2. بوابة العميل بالتوكن السري: قراءة مستند واحد فقط بالتوكن (ممنوع الـ list لمنع سحب بوابات العملاء)
    match /portal_shares/{token} {
      allow get: if true;
      allow list: if false;
      // السماح لأعضاء الشركة الموثقين بنشر وتحديث بوابات مشاريع شركتهم، وللسوبر أدمن
      allow write: if isAuthenticated() && (
        (request.resource != null && (request.auth.token.companyId == request.resource.data.companyId || isSuperAdmin())) ||
        (resource != null && (request.auth.token.companyId == resource.data.companyId || isSuperAdmin())) ||
        isSuperAdmin()
      );
    }

    // 3. منصة الإدارة المركزية (platform_metadata)
    // منع الوصول لبيانات المشرف السري
    match /platform_metadata/superadmin {
      allow read, write: if false;
    }

    // إعدادات المنصة: قراءة للجميع، كتابة للمشرف العام
    match /platform_metadata/platform_settings {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // دليل الشركات المشتركة: متاح للقراءة لدعم النطاقات الفرعية (Subdomains) للزوار، كتابة للمشرف العام فقط
    match /platform_metadata/tenants {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // دليل السابدومين العام المخصص لربط السابدومين بالشركة للزوار بدون تسجيل دخول
    // يسمح بـ get فقط للزائر، ويمنع list ويمنع الكتابة لغير السوبر أدمن لمنع العبث أو سرقة النطاقات
    match /tenant_directory/{subdomain} {
      allow get: if true;
      allow list: if false;
      allow write: if isSuperAdmin();
    }

    // دليل المستخدمين المركزي: قراءة للمستخدمين الموثقين، وكتابة للمشرف العام فقط (عزل المستأجرين)
    match /platform_metadata/users_directory {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // أي وثائق إدارية أخرى في platform_metadata
    match /platform_metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 4. إغلاق أي مسار آخر غير معرف
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

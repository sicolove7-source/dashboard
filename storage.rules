rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.isSuperAdmin == true
      );
    }

    function companyBelongsToUser(companyId) {
      let tokenCompId = request.auth.token.companyId;
      return isSuperAdmin() || (
        isAuthenticated() && tokenCompId != null &&
        (
          tokenCompId == companyId ||
          ('comp_' + companyId) == tokenCompId ||
          companyId == ('comp_' + tokenCompId)
        )
      );
    }

    function isValidMedia() {
      return request.resource.size < 50 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*|application/pdf|video/.*');
    }

    // شعارات وهوية الشركة العامة للعرض
    match /companies/{companyId}/branding/{allPaths=**} {
      allow read: if true;
      allow write: if isValidMedia() && companyBelongsToUser(companyId);
    }

    // ملفات وعقود ومستندات الشركة الخاصة
    match /companies/{companyId}/{allPaths=**} {
      allow read: if isAuthenticated() && companyBelongsToUser(companyId);
      allow write: if isValidMedia() && companyBelongsToUser(companyId);
    }

    match /site_media/{companyId}/{allPaths=**} {
      allow read: if isAuthenticated() && companyBelongsToUser(companyId);
      allow write: if isValidMedia() && isAuthenticated() && companyBelongsToUser(companyId);
    }

    match /site_media/{allPaths=**} {
      allow read: if isAuthenticated() && isSuperAdmin();
      allow write: if isValidMedia() && isAuthenticated() && isSuperAdmin();
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
